# Copy to .env.production and fill in REACT_APP_WALLET_CONNECT_PROJECT_ID before building.
# Do NOT commit .env.production — it is gitignored.

REACT_APP_BROWSER_ROUTER=true

REACT_APP_AMPLITUDE_PROXY_URL=http://localhost:3001/v1
REACT_APP_AWS_API_ENDPOINT=http://localhost:3001/v1
REACT_APP_STATSIG_PROXY_URL=http://localhost:3001/v1
REACT_APP_TEMP_API_URL=http://localhost:3001/v1
REACT_APP_UNISWAP_BASE_API_URL=http://localhost:3001/v1
REACT_APP_UNISWAP_GATEWAY_DNS=http://localhost:3001/v1
REACT_APP_TRADING_API_URL_OVERRIDE=http://localhost:3001/v1

REACT_APP_TRADING_API_KEY=TRADING_API_KEY
REACT_APP_TRADING_API_TEST_ENV=true
REACT_APP_IS_UNISWAP_INTERFACE=true

# Supply a valid WalletConnect project ID (https://cloud.walletconnect.com).
# Can also be set in .env.production.local to keep it out of this file entirely.
REACT_APP_WALLET_CONNECT_PROJECT_ID=
